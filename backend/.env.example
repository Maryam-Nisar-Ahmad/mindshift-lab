# Copy this file to backend/.env and fill in your own keys.
# Nothing here has a real value checked in — see README.md for what each
# step of the pipeline actually needs.

# Required for: script/prompt generation, SEO, subtitle cleanup (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Optional. Only needed for OpenAI-backed thumbnail prompts/cloud transcription.
# Local transcription (faster-whisper) works with no key at all.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Optional tuning (all have working defaults in code) ---

# Transcription backend: local (faster-whisper, free) or openai (cloud, paid)
# TRANSCRIPTION_BACKEND=local
# FASTER_WHISPER_MODEL=base
# WHISPER_LOCAL_DEVICE=cpu
# WHISPER_LOCAL_COMPUTE_TYPE=int8
# WHISPER_LOCAL_BEAM_SIZE=5
# WHISPER_LOCAL_VAD=1

# WhisperX forced alignment + Demucs vocal separation (install separately, see
# backend/requirements.txt for the pip commands)
# WHISPERX_DEVICE=auto
# WHISPERX_ALIGN_DEFAULT=0
# DEMUCS_DEVICE=auto
# DEMUCS_BEFORE_ALIGN=0

# Thumbnail prompt generation
# THUMBNAIL_PROMPT_PROVIDER=openai
# OPENAI_THUMBNAIL_MODEL=gpt-4o
# OPENAI_THUMBNAIL_MAX_TOKENS=8192

# Script splitting / Midjourney prompt generation call tuning
# SCRIPT_SPLIT_CHUNK_CHARS=9000
# DEEPSEEK_SPLIT_MAX_TOKENS=8192
# DEEPSEEK_SPLIT_TIMEOUT_SECONDS=60
# MJ_PROMPT_MAX_OUTPUT_TOKENS=8192
# MJ_PROMPT_CALL_TIMEOUT_SECONDS=120
# MJ_PROMPT_USER_MAX_CHARS=4500
